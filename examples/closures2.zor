fun outer() {
  var x = "outside";
  fun inner() {
    print x;
  }
  return inner;
}

var closure = outer();

// Push new values into the stack slots outer() previously used:
fun trashStack() {
  var a = "CORRUPTED 1";
  var b = "CORRUPTED 2";
}
trashStack();

closure(); // This should print "outside".